@model IEnumerable<CMS.Data.Entities.Banner>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Danh sách Banner";
}

<div class="container mt-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold text-dark">
            <i class="bi bi-image"></i> DANH SÁCH BANNER
        </h3>

        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Thêm Banner
        </a>
    </div>

    <!-- TABLE WRAPPER -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <!-- HEADER TABLE -->
                    <thead class="table-dark">
                        <tr>
                            <th style="width:80px;">#</th>
                            <th>Hình ảnh</th>
                            <th>Tiêu đề</th>
                            <th style="width:160px;">Hành động</th>
                        </tr>
                    </thead>

                    <!-- BODY TABLE -->
                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <!-- ID -->
                                <td class="fw-bold text-muted">
                                    @item.Id
                                </td>

                                <!-- IMAGE -->
                                <td>
                                    <img src="@item.ImageUrl"
                                         style="width:120px; height:70px; object-fit:cover; border-radius:8px;" />
                                </td>

                                <!-- TITLE -->
                                <td class="fw-semibold text-primary">
                                    @item.Title
                                </td>

                                <!-- ACTION -->
                                <td>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-warning">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-danger"
                                       onclick="return confirm('Xóa banner này?')">
                                        <i class="bi bi-trash"></i>
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>